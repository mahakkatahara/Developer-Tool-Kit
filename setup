#!/bin/bash

NC=$'\033[0m'
RED=$'\033[38;5;203m'
GREEN=$'\033[38;5;114m'
YELLOW=$'\033[38;5;180m'
BLUE=$'\033[38;5;75m'
MAGENTA=$'\033[38;5;139m'
CYAN=$'\033[38;5;73m'
WHITE=$'\033[38;5;255m'

clear

echo -e "${BLUE}============================================================${NC}"
echo -e "${CYAN}         MACHINE LEARNING DEVELOPMENT KIT${NC}"
echo -e "${BLUE}============================================================${NC}"
echo -e "${MAGENTA}         💻 Environment Setup (Auto Venv) 💻${NC}\n"

# Check operating system
OS="$(uname -s)"

if [[ "$OS" == "Darwin" ]]; then
    echo -e "${GREEN}✔ macOS detected.${NC}"
elif [[ "$OS" == "Linux" ]]; then
    echo -e "${GREEN}✔ Linux detected.${NC}"
else
    echo -e "${RED}Unsupported operating system: $OS${NC}"
    exit 1
fi

# Check Homebrew
if command -v brew >/dev/null 2>&1; then
    BREW_AVAILABLE=true
else
    BREW_AVAILABLE=false
fi

echo -e "${BLUE}------------------------------------------------------------"
echo -e "                Checking Python, pip, and venv"
echo -e "------------------------------------------------------------${NC}"

# Check Python
if ! command -v python3 >/dev/null 2>&1; then
    echo -e "${RED}Python not found.${NC}"

    if [[ "$OS" == "Darwin" ]]; then
        if [[ "$BREW_AVAILABLE" == true ]]; then
            echo -e "${CYAN}Installing Python using Homebrew...${NC}"
            brew install python || {
                echo -e "${RED}Python installation failed.${NC}"
                exit 1
            }
        else
            echo -e "${RED}Homebrew is required to install Python on macOS.${NC}"
            exit 1
        fi

    elif [[ "$OS" == "Linux" ]]; then
        if command -v apt-get >/dev/null 2>&1; then
            echo -e "${CYAN}Installing Python using apt...${NC}"
            sudo apt-get update
            sudo apt-get install -y python3 python3-pip python3-venv || {
                echo -e "${RED}Python installation failed.${NC}"
                exit 1
            }
        else
            echo -e "${RED}This Linux distribution is not supported for automatic installation.${NC}"
            exit 1
        fi
    fi
else
    echo -e "${GREEN}✔ Python installed:${NC} $(python3 --version)"
fi

# Check pip
if ! python3 -m pip --version >/dev/null 2>&1; then
    echo -e "${RED}pip is not available. Please check your Python installation.${NC}"
    exit 1
else
    echo -e "${GREEN}✔ pip installed${NC}"
fi

echo -e "${GREEN}✔ Python virtual environment support is ready.${NC}"

echo -e "\n${BLUE}------------------------------------------------------------"
echo -e "       Creating Virtual Environment in Current Directory"
echo -e "------------------------------------------------------------${NC}"

VENV_PATH="./venv"

if [[ -d "$VENV_PATH" && -f "$VENV_PATH/bin/activate" ]]; then
    echo -e "${GREEN}✔ Existing valid venv detected.${NC}"
else
    echo -e "${CYAN}→ Creating new venv...${NC}"
    if [[ -d "$VENV_PATH" ]]; then
        echo -e "${YELLOW}Removing invalid existing venv...${NC}"
        rm -rf "$VENV_PATH"
    fi

    python3 -m venv "$VENV_PATH" || {
        echo -e "${RED}Failed creating virtual environment.${NC}"
        exit 1
    }
    echo -e "${GREEN}✔ Virtual environment created.${NC}"
fi

echo -e "${BLUE}→ Activating venv...${NC}"
source "$VENV_PATH/bin/activate" || {
    echo -e "${RED}Failed activating venv.${NC}"
    exit 1
}

echo -e "${CYAN}→ Upgrading pip inside venv...${NC}"
python -m pip install --upgrade pip || {
    echo -e "${RED}pip upgrade failed.${NC}"
    exit 1
}

echo -e "\n${BLUE}------------------------------------------------------------"
echo -e "                Machine Learning Libraries"
echo -e "------------------------------------------------------------${NC}"

read -r -p "Install core ML libraries (numpy, pandas, sklearn, etc.)? [Y/n]: " ML
if [[ "$ML" =~ ^[Yy]$ || -z "$ML" ]]; then
    echo -e "${CYAN}→ Installing ML libraries...${NC}"
    python -m pip install numpy pandas matplotlib seaborn scikit-learn scipy || {
        echo -e "${RED}ML library installation failed.${NC}"
        exit 1
    }
    echo -e "${GREEN}✔ ML libraries installed.${NC}"
fi

read -r -p "Install Jupyter Notebook & Lab? [Y/n]: " JP
if [[ "$JP" =~ ^[Yy]$ || -z "$JP" ]]; then
    echo -e "${CYAN}→ Installing Jupyter...${NC}"
    python -m pip install notebook jupyterlab || {
        echo -e "${RED}Jupyter installation failed.${NC}"
        exit 1
    }
    echo -e "${GREEN}✔ Jupyter installed.${NC}"
fi

read -r -p "Install Git? [Y/n]: " GT
if [[ "$GT" =~ ^[Yy]$ || -z "$GT" ]]; then
    if command -v git >/dev/null 2>&1; then
        echo -e "${GREEN}✔ Git is already installed: $(git --version)${NC}"

    elif [[ "$OS" == "Darwin" ]]; then
        if [[ "$BREW_AVAILABLE" == true ]]; then
            echo -e "${CYAN}→ Installing Git using Homebrew...${NC}"
            brew install git || {
                echo -e "${RED}Git installation failed.${NC}"
                exit 1
            }
        else
            echo -e "${YELLOW}Install Homebrew to install Git automatically.${NC}"
        fi

    elif [[ "$OS" == "Linux" ]]; then
        if command -v apt-get >/dev/null 2>&1; then
            echo -e "${CYAN}→ Installing Git using apt...${NC}"
            sudo apt-get update
            sudo apt-get install -y git || {
                echo -e "${RED}Git installation failed.${NC}"
                exit 1
            }
        else
            echo -e "${YELLOW}Please install Git using your Linux package manager.${NC}"
        fi
    fi

    if command -v git >/dev/null 2>&1; then
        echo -e "${GREEN}✔ Git installation completed.${NC}"
    fi
fi
read -r -p "Install Visual Studio Code? [Y/n]: " VC
if [[ "$VC" =~ ^[Yy]$ || -z "$VC" ]]; then

    if [[ "$OS" == "Darwin" ]]; then
        if [[ -d "/Applications/Visual Studio Code.app" ]]; then
            echo -e "${GREEN}✔ Visual Studio Code is already installed.${NC}"
        elif [[ "$BREW_AVAILABLE" == true ]]; then
            echo -e "${CYAN}→ Installing VS Code using Homebrew...${NC}"
            brew install --cask visual-studio-code || {
                echo -e "${RED}VS Code installation failed.${NC}"
                exit 1
            }
        else
            echo -e "${YELLOW}Install Homebrew to install VS Code automatically.${NC}"
        fi

    elif [[ "$OS" == "Linux" ]]; then
        if command -v code >/dev/null 2>&1; then
            echo -e "${GREEN}✔ Visual Studio Code is already installed.${NC}"
        elif command -v snap >/dev/null 2>&1; then
            echo -e "${CYAN}→ Installing VS Code using Snap...${NC}"
            sudo snap install code --classic || {
                echo -e "${RED}VS Code installation failed.${NC}"
                exit 1
            }
        else
            echo -e "${YELLOW}Snap is not available. Please install VS Code manually.${NC}"
            echo "Visit: https://code.visualstudio.com/"
        fi
    fi
fi
echo -e "\n${GREEN}============================================================"
echo -e "           Setup Completed Successfully!"
echo -e "============================================================${NC}\n"

echo -e "${CYAN}To activate your virtual environment, run:${NC}"
echo "To activate it again later, run: source venv/bin/activate"
echo "To deactivate it, run: deactivate"
